# Perfil cache-768mb — instância SÓ DE CACHE do par de duas instâncias
#
# Quando usar: com `fila-256mb` (redis/docker-compose.par.yml).
# Nunca sozinho para cache+fila — este perfil despeja QUALQUER chave.
#
#   cache  → allkeys-lru, sem persistência
#   fila   → noeviction, AOF
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/cache-768mb.env -o .env.cache
#   # depois acrescente: REDIS_PASSWORD=...

REDIS_MAXMEMORY=768mb
# allkeys-lru: numa instância só de cache, chave sem TTL também é cache.
REDIS_MAXMEMORY_POLICY=allkeys-lru
# Sem persistência — evita fork do rewrite do AOF nesta instância.
REDIS_APPENDONLY=no
# Sem AOF: maxmemory + folga basta (não precisa de 2×).
REDIS_MEMORY_LIMIT=1G
