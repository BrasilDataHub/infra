# Perfil cache-768mb — instância SÓ DE CACHE do par de duas instâncias
#
# Quando usar: com `fila-256mb`, no desenho de duas instâncias
# (redis/docker-compose.par.yml). Nunca sozinho para cache+fila — este perfil
# despeja QUALQUER chave, inclusive job pendente.
#
# O par existe por uma medição: 34.007 evicções e hit rate de 59,7% numa única
# instância de 512 MB compartilhada entre cache e sessões. Como só as sessões
# tinham TTL no db 0, e a política era `volatile-lru`, **parte dos despejos
# eram usuários sendo deslogados** — o cache crescia e a sessão de alguém saía.
#
# Separadas, cada lado ganha a política certa:
#   cache  → allkeys-lru, sem persistência: despejar é o comportamento correto
#   fila   → noeviction, AOF: perder um job NÃO é comportamento correto
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/infra/main/redis/profiles/cache-768mb.env -o .env.cache
#   # depois acrescente: REDIS_PASSWORD=...

REDIS_MAXMEMORY=768mb
# allkeys-lru, e não volatile-lru: numa instância só de cache, chave sem TTL
# também é cache, e recusar despejá-la faria o Redis responder OOM a um SET em
# vez de liberar espaço.
REDIS_MAXMEMORY_POLICY=allkeys-lru
# SEM persistência. Não é economia de disco: é o fork do rewrite do AOF que
# deixa de acontecer, e com ele o pico copy-on-write que obrigaria o limite de
# container a ser ~2× o maxmemory. Um restart perder o cache é o comportamento
# correto — ele se refaz sozinho.
REDIS_APPENDONLY=no
# 1G para 768mb de dados: sem AOF, a folga cobre fragmentação e buffers de
# cliente, não o fork.
REDIS_MEMORY_LIMIT=1G
