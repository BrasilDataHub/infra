# Perfil fila-256mb — instância de FILA E SESSÕES do par de duas instâncias
#
# Quando usar: com `cache-768mb`, no desenho de duas instâncias
# (redis/docker-compose.par.yml).
#
# É o lado onde perder dado tem consequência: job, sessão, lock.
# Política: noeviction + AOF (oposta ao lado de cache).
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/fila-256mb.env -o .env.fila
#   # depois acrescente: REDIS_PASSWORD=...

REDIS_MAXMEMORY=256mb
# noeviction: no teto, recusa escrita com erro (alerta RedisPertoDoMaxmemory).
REDIS_MAXMEMORY_POLICY=noeviction
# AOF everysec: jobs sobrevivem a restart do container.
REDIS_APPENDONLY=yes
# ~2× maxmemory pelo fork copy-on-write do rewrite do AOF.
REDIS_MEMORY_LIMIT=512M
