# Perfil fila-256mb — instância de FILA E SESSÕES do par de duas instâncias
#
# Quando usar: com `cache-768mb`, no desenho de duas instâncias
# (redis/docker-compose.par.yml).
#
# É o lado onde perder dado tem consequência: job do Horizon enfileirado,
# sessão de usuário logado, lock de agendamento. Daí as duas escolhas opostas
# às do lado de cache.
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/fila-256mb.env -o .env.fila
#   # depois acrescente: REDIS_PASSWORD=...

REDIS_MAXMEMORY=256mb
# noeviction: chegando ao teto, o Redis RECUSA a escrita com um erro em vez de
# descartar um job em silêncio. Um erro visível no enfileiramento é
# infinitamente melhor que uma exportação que nunca aconteceu e ninguém soube.
# O alerta RedisPertoDoMaxmemory é o aviso antes de chegar lá.
REDIS_MAXMEMORY_POLICY=noeviction
# AOF everysec: jobs enfileirados sobrevivem a restart do container.
REDIS_APPENDONLY=yes
# ~2× maxmemory por causa do fork copy-on-write do rewrite do AOF.
REDIS_MEMORY_LIMIT=512M
