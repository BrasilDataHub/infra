# Perfil cache-4gb — Redis da BrasilDataHub
#
# Quando usar: instância DEDICADA A CACHE, sem fila e sem sessão autenticada,
# num host com 8 GiB ou mais. É o perfil do Base Empresarial desde 01/08/2026.
# Justificativa e regra do headroom de memória: redis/README.md
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/cache-4gb.env -o .env
#   # depois acrescente: REDIS_PASSWORD=...
#   # e, se quiser mudar os defaults: BIND_IP, REDIS_PORT, REDIS_VOLUME.
#
# NÃO use este perfil se a instância também servir fila: `allkeys-lru` descarta
# o job pendente junto com a chave de cache. Nesse caso o certo é o par de
# instâncias — redis/docker-compose.par.yml e redis/README-par.md.

# teto de memória de dados
REDIS_MAXMEMORY=4gb

# allkeys-lru, e não volatile-lru: aqui TUDO é cache, então despejar o menos
# usado é o comportamento correto e a instância nunca precisa recusar escrita.
# Medido no Base Empresarial com 2 GiB e volatile-lru: 5,5 despejos/s e hit
# rate de 76,8%. Com 4 GiB e allkeys-lru: 0 despejos.
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Sem AOF: esta instância é cache, e a aplicação sabe reconstruir o que ela
# guarda. O AOF cobraria um fsync por segundo e um arquivo do tamanho do
# dataset (eram 711 MB) para proteger dado descartável. O RDB continua ligado
# — ele não serve para durabilidade, serve para o cache voltar QUENTE depois
# de um restart, o que evita uma onda de miss na origem.
REDIS_APPENDONLY=no

# Limite de container = maxmemory + 1 GiB, e não 2× como nos perfis com AOF.
# A regra de 2× existe pelo copy-on-write do rewrite do AOF; sem AOF sobra só
# o fork do RDB, cujo COW medido aqui foi de 4,7 MB. O 1 GiB extra cobre
# overhead do Redis (~43 MB) e fragmentação (medida: 1,01).
#
# Confira o headroom do host antes: com 4gb aqui o processo fica em ~4,1 GiB,
# e ainda precisam caber o SO e uma eventual instância de fila (512M).
REDIS_MEMORY_LIMIT=5G
