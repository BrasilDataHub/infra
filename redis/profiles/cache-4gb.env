# Perfil cache-4gb — Redis da BrasilDataHub
#
# Quando usar: instância DEDICADA A CACHE, sem fila e sem sessão autenticada,
# num host com 8 GiB ou mais (perfil do Base Empresarial).
# Headroom de memória: redis/README.md
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/cache-4gb.env -o .env
#   # depois acrescente: REDIS_PASSWORD=...
#   # e, se quiser mudar os defaults: BIND_IP, REDIS_PORT, REDIS_VOLUME.
#
# NÃO use se a instância também servir fila (`allkeys-lru` descarta jobs).
# Nesse caso: redis/docker-compose.par.yml e redis/README-par.md.

# teto de memória de dados
REDIS_MAXMEMORY=4gb

# allkeys-lru: tudo é cache — despejar o menos usado é o comportamento correto.
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Sem AOF: cache reconstruível. RDB fica ligado para voltar quente após restart.
REDIS_APPENDONLY=no

# Limite = maxmemory + 1 GiB (sem AOF não precisa de 2×). Confira headroom
# do host: ~4,1 GiB de processo + SO + eventual fila (512M).
REDIS_MEMORY_LIMIT=5G
