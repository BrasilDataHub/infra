# Perfil cache-2gb — Redis da BrasilDataHub
#
# Quando usar: teto do catálogo; acima disso, separe instâncias por projeto
# Justificativa e regra do headroom de memória: redis/README.md
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/redis/profiles/cache-2gb.env -o .env
#   # depois acrescente: REDIS_PASSWORD=...
#   # e, se quiser mudar os defaults: BIND_IP, REDIS_PORT, REDIS_VOLUME.
#
# É este o arquivo que o setup.sh baixa.

# teto de memória de dados
REDIS_MAXMEMORY=2gb
# volatile-lru despeja só chaves com TTL — as da fila/Horizon nunca são
# despejadas. Instâncias só de cache podem usar allkeys-lru.
REDIS_MAXMEMORY_POLICY=volatile-lru
# limite de container ≈ 2× maxmemory: o rewrite do AOF forka e as páginas
# copy-on-write podem dobrar a memória do processo.
REDIS_MEMORY_LIMIT=3G
