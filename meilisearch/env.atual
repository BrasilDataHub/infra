# Perfil ATUAL — host compartilhado de 8 GB, só os índices de territórios
# (3,6 MB). A config de hoje permite MEILI_MAX_INDEXING_MEMORY de 6 GiB —
# sentença de OOM no host; este perfil limita a 1 GiB (limite de container:
# 1 GB, definido no Dokploy/compose).

MEILI_ENV=production
# MEILI_MASTER_KEY=<definir no Dokploy — nunca commitar>
MEILI_MAX_INDEXING_MEMORY=1GiB
MEILI_MAX_INDEXING_THREADS=1
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=100MB
MEILI_NO_ANALYTICS=true
MEILI_DB_PATH=/meili_data
