# Perfil BUSCA-16GB — índices grandes (dezenas de milhões de documentos).
# É o perfil pós-migração do Base Empresarial (ex-"pos-migracao"):
# indexação completa de establishments (72M docs) e partners (26M), índice
# estimado em 15–25 GB (AG15). Assume ≥16 GB de RAM livres para o serviço;
# ajustar proporcionalmente à máquina.
#
# Regra de bolso: MEILI_MAX_INDEXING_MEMORY ≈ metade da RAM disponível para
# o serviço; limite de container ≈ 2× esse valor durante a indexação.

MEILI_ENV=production
# MEILI_MASTER_KEY=<definir no Dokploy — nunca commitar>
MEILI_MAX_INDEXING_MEMORY=8GiB
MEILI_MAX_INDEXING_THREADS=4
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=250MB
MEILI_NO_ANALYTICS=true
MEILI_DB_PATH=/meili_data
