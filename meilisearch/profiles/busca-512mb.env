# Perfil busca-512mb — Meilisearch da BrasilDataHub
#
# Quando usar: projetos pequenos (~170 mil docs); índices de MB a centenas de MB
# Regra de dimensionamento e limitações: meilisearch/README.md
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/plataforma/main/meilisearch/profiles/busca-512mb.env -o .env
#   # depois acrescente: MEILI_MASTER_KEY=...   (mínimo 16 bytes)
#   # e, se quiser mudar os defaults: BIND_IP, MEILI_PORT, MEILI_VOLUME.
#
# É este o arquivo que o setup.sh baixa.

# ≈ metade da RAM disponível para o serviço
MEILI_MAX_INDEXING_MEMORY=256MiB
MEILI_MAX_INDEXING_THREADS=1
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=50MB
# limite de container ≈ 2× MEILI_MAX_INDEXING_MEMORY durante a indexação
MEILI_MEMORY_LIMIT=512M
