# Perfil busca-1gb — Meilisearch da BrasilDataHub
#
# Quando usar: índices de poucos GB
# Regra de dimensionamento e limitações: meilisearch/README.md
#
# Uso:
#   curl -fsSL https://raw.githubusercontent.com/BrasilDataHub/infra/main/meilisearch/profiles/busca-1gb.env -o .env
#   # depois acrescente: MEILI_MASTER_KEY=...   (mínimo 16 bytes)
#   # e, se quiser mudar os defaults: BIND_IP, MEILI_PORT, MEILI_VOLUME.
#
# É este o arquivo que o infra-setup.sh baixa.

# ≈ metade da RAM disponível para o serviço
MEILI_MAX_INDEXING_MEMORY=1GiB
MEILI_MAX_INDEXING_THREADS=1
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=100MB
# limite de container ≈ 2× MEILI_MAX_INDEXING_MEMORY durante a indexação
MEILI_MEMORY_LIMIT=1G
