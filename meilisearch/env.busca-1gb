# Perfil BUSCA-1GB — host compartilhado ou índices pequenos (poucos GB).
# É o perfil da instância atual do Base Empresarial (ex-"atual"): só os
# índices de territórios, 3,6 MB. Limita a indexação a 1 GiB — a config
# anterior permitia 6 GiB, sentença de OOM num host de 8 GB dividido.
# Limite de container recomendado: 1G.

MEILI_ENV=production
# MEILI_MASTER_KEY=<definir no Dokploy — nunca commitar>
MEILI_MAX_INDEXING_MEMORY=1GiB
MEILI_MAX_INDEXING_THREADS=1
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=100MB
MEILI_NO_ANALYTICS=true
MEILI_DB_PATH=/meili_data
