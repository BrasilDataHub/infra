# Perfil BUSCA-4GB — índices médios (milhões de documentos, alguns GB):
# indexação regular sem monopolizar o host.
# Limite de container recomendado: 4G durante indexação; ~2G em regime.
MEILI_ENV=production
# MEILI_MASTER_KEY=<definir no deploy — nunca commitar>
MEILI_MAX_INDEXING_MEMORY=2GiB
MEILI_MAX_INDEXING_THREADS=2
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=100MB
MEILI_NO_ANALYTICS=true
MEILI_DB_PATH=/meili_data
