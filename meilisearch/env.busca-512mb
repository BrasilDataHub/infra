# Perfil BUSCA-512MB — projetos pequenos (ex.: Base Escolar, ~170 mil
# documentos): índices de poucos MB a poucas centenas de MB.
# Limite de container recomendado: 512M.
MEILI_ENV=production
# MEILI_MASTER_KEY=<definir no deploy — nunca commitar>
MEILI_MAX_INDEXING_MEMORY=256MiB
MEILI_MAX_INDEXING_THREADS=1
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=50MB
MEILI_NO_ANALYTICS=true
MEILI_DB_PATH=/meili_data
