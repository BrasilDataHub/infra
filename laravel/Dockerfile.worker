# Runtime worker Laravel (ghcr.io/brasildatahub/laravel-worker): deriva do laravel-app.
#
# Papéis via CONTAINER_ROLE: worker, horizon, scheduler, reverb.
# Herda PHP ZTS, extensões e ini do app. HEALTHCHECK NONE evita herdar /up do app.

ARG BASE_IMAGE=ghcr.io/brasildatahub/laravel-app
ARG BASE_TAG=8.4-r3

FROM ${BASE_IMAGE}:${BASE_TAG}

COPY entrypoint-worker.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

ENTRYPOINT ["/usr/local/bin/entrypoint"]

ENV CONTAINER_ROLE=worker
HEALTHCHECK NONE
