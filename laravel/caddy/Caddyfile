{
    {$CADDY_GLOBAL_OPTIONS}

    admin :{$CADDY_SERVER_ADMIN_PORT:2019}

    frankenphp {
        # num_threads é o TOTAL de threads PHP do processo; `num`, lá dentro,
        # é quantas delas atendem o worker script. Sem a linha de fora, o
        # `num` de dentro não basta: com apenas a diretiva do worker o
        # FrankenPHP manteve UMA thread ativa e serializou todas as
        # requisições — medido em produção, 30 pedidos paralelos viraram uma
        # escada de 1,84 s a 3,32 s com um núcleo inteiro ocioso.
        #
        # Quem calcula os valores é o entrypoint, a partir da CPU e da memória
        # que o container realmente tem. Os defaults abaixo só valem para quem
        # subir o FrankenPHP sem passar por ele, e são deliberadamente baixos:
        # errar para menos custa vazão, errar para mais custa OOM.
        num_threads {$FRANKENPHP_NUM_THREADS:4}
        max_threads {$FRANKENPHP_MAX_THREADS:8}

        worker {
            file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
            {$CADDY_SERVER_WORKER_DIRECTIVE}
            {$CADDY_SERVER_WATCH_DIRECTIVES}
        }
    }
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME::8000} {
    log {
        level {$CADDY_SERVER_LOG_LEVEL:warn}

        format filter {
            wrap {$CADDY_SERVER_LOGGER:console}
            fields {
                uri query {
                    replace authorization REDACTED
                }
            }
        }
    }

    route {
        root * "{$APP_PUBLIC_PATH}"

        request_body {
            max_size 5GB
        }

        encode zstd br gzip

        # Os nomes em /build carregam hash do conteúdo, então nunca mudam de
        # significado: podem ser cacheados para sempre pelo navegador e por
        # qualquer CDN à frente.
        @versioned_assets path /build/*
        header @versioned_assets Cache-Control "public, max-age=31536000, immutable"

        {$CADDY_SERVER_EXTRA_DIRECTIVES}

        php_server {
            resolve_root_symlink
        }
    }
}
