# Perfil compartilhada-8gb — OpenSearch da BrasilDataHub
#
# Máquina-alvo: host de 31 GiB e 12 vCPU COMPARTILHADO com o PostgreSQL
# (14 GiB, perfil compartilhada-14gb). O OpenSearch fica com 8 GiB de limite de
# container e ~7 GiB de RSS esperado.
#
# A CONTA DO HOST (03 §3.1), que é o que torna este perfil obrigatório:
#
#   kernel, docker, sshd, exporters .... 1,5 GiB
#   PostgreSQL ......................... 14,0 GiB
#   OpenSearch ......................... 8,0 GiB
#   ------------------------------------------- regime: 23,5 de 31 GiB
#   page cache livre ................... 7,5 GiB     ✔
#
# Os 7,5 GiB livres são o número que importa, não o limite do container: o
# `mmap` do Lucene NÃO conta no RSS do cgroup — conta como page cache
# reclamável. É onde os 5,3 GB quentes do índice ficam residentes.
#
# ─────────────────────────────────────────────────────────────────────────────
# POR QUE NÃO CABE NO bdh-apps
#
# O mínimo viável do OpenSearch é 13,1 GiB (heap + direct + metaspace + threads
# + page cache do índice). O bdh-apps tem 7,987 GiB TOTAIS, dos quais 7,292 já
# estão comprometidos com Octane, Horizon, Traefik, os dois Redis, PgBouncer e
# a stack de observabilidade. Não é questão de apertar: falta mais do que existe.
# ─────────────────────────────────────────────────────────────────────────────

# --- recursos do container ---------------------------------------------------
OS_MEMORY_LIMIT=8G
# 12 vCPU divididas com o Postgres. Sem teto, um merge de 6 shards consome a
# máquina inteira no meio de uma carga.
OS_CPU_LIMIT=6

# --- heap --------------------------------------------------------------------
# 4 GiB = 50% do limite do container, a regra do produto, e bem abaixo dos 31 GB
# em que os compressed oops deixam de valer.
#
# A suficiência se PROVA, não se estima (03 §3.1): com `_source: false` e
# doc_values, o on-heap em regime é dominado pelo FST de `razao_social`
# (~12 M termos × ~20 B ≈ 240 MiB); os outros 27 campos são de baixa
# cardinalidade (< 20 MiB); fielddata é ZERO por breaker; e as agregações
# `terms` sobre 915 CNAEs e 3.732 municípios usam global ordinals (~44 KB por
# shard). Total on-heap < 700 MiB de 4 GiB.
#
# Os outros 4 GiB do container cobrem Netty direct (1 GiB), metaspace (256 MiB),
# thread stacks (~600 MiB) e folga contra o OOM-killer do cgroup.
OS_JAVA_OPTS=-Xms4g -Xmx4g -XX:MaxDirectMemorySize=1g

# --- breakers ----------------------------------------------------------------
# fielddata em 0%: o mapping usa doc_values em tudo que é agregado, então
# QUALQUER uso de fielddata é um erro de consulta — e é melhor que ele falhe
# rápido do que consuma heap até o OOM.
OS_BREAKER_FIELDDATA_LIMIT=0%
OS_BREAKER_TOTAL_LIMIT=70%
OS_BREAKER_REQUEST_LIMIT=40%

# --- watermarks de disco -----------------------------------------------------
# O `flood_stage` põe TODOS os índices em read-only quando o disco passa do
# limiar, e é a interrupção autoinfligida nº 1 desta classe de serviço. Os
# valores são conservadores de propósito: o NVMe é compartilhado com um PGDATA
# de 134 GB que cresce a cada carga.
OS_WATERMARK_LOW=75%
OS_WATERMARK_HIGH=85%
OS_WATERMARK_FLOOD=90%

# --- índice ------------------------------------------------------------------
# AS CONFIGURAÇÕES DE ÍNDICE NÃO VIVEM AQUI. `merge.scheduler.max_thread_count`,
# `refresh_interval` e `translog.*` são settings de ÍNDICE, e o OpenSearch não
# os aceita em opensearch.yml (que é o que uma variável de ambiente do container
# vira) — só via API ou no corpo de criação do índice.
#
# Eles estão no mapping versionado, em ../index/busca_estabelecimento.json.
#
# Havia aqui um `OS_MERGE_THREADS=1` que NENHUM lugar lia: nem o compose o
# referencia, nem o motor o aceitaria. O valor real (1 thread por shard em
# regime) sempre veio do mapping; a variável só dava a impressão de estar
# configurando algo.
