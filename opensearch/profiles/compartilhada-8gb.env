# Perfil compartilhada-8gb — OpenSearch da BrasilDataHub
#
# Host de 31 GiB / 12 vCPU compartilhado com PostgreSQL (perfil
# compartilhada-14gb). Limite do container: 8 GiB; heap 4 GiB (50%).
# ~7,5 GiB de page cache livre para o mmap do Lucene (índice quente ~5,3 GB).
#
# Mínimo viável ~13 GiB (heap + off-heap + page cache) — não cabe no bdh-apps.

# --- recursos do container ---------------------------------------------------
OS_MEMORY_LIMIT=8G
# 12 vCPU divididas com o Postgres.
OS_CPU_LIMIT=6

# --- heap --------------------------------------------------------------------
# 4 GiB = 50% do limite. On-heap em regime < 700 MiB (FST + doc_values).
# Os outros 4 GiB cobrem Netty direct, metaspace, thread stacks e folga.
OS_JAVA_OPTS=-Xms4g -Xmx4g -XX:MaxDirectMemorySize=1g

# --- breakers ----------------------------------------------------------------
# fielddata 0%: mapping usa doc_values; qualquer uso de fielddata é erro de consulta.
OS_BREAKER_FIELDDATA_LIMIT=0%
OS_BREAKER_TOTAL_LIMIT=70%
OS_BREAKER_REQUEST_LIMIT=40%

# --- watermarks de disco -----------------------------------------------------
# flood_stage põe todos os índices em read-only. NVMe compartilhado com PGDATA.
OS_WATERMARK_LOW=75%
OS_WATERMARK_HIGH=85%
OS_WATERMARK_FLOOD=90%

# --- índice ------------------------------------------------------------------
# Settings de índice (`merge.*`, `refresh_interval`, `translog.*`) vivem no
# mapping versionado: ../index/busca_estabelecimento.json — não em opensearch.yml.
