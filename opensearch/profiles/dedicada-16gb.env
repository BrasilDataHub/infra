# Perfil dedicada-16gb — OpenSearch da BrasilDataHub
#
# Host de ~16 GiB / 4 vCPU dedicado ao motor de busca (Postgres noutra máquina).
# Limite do container: 13 GiB; heap 6 GiB. O que sobra do heap dentro do
# cgroup é page cache do Lucene, e é ele que decide a latência de busca.
#
# O perfil anterior (10 GiB de limite, heap 5 GiB) deixava ~4 GiB de page cache
# para um índice que hoje tem 10,1 GB — menos da metade — e 6 GiB da máquina
# ociosos. Page cache é reclaimable: o kernel o devolve sob pressão, então o
# limite maior não aproxima o container do OOM; quem tem de caber com folga é o
# que NÃO é reclaimable (heap + direct + metaspace ≈ 7,5 GiB).
#
# Breaker `parent` a 70% em regime; na janela de carga inicial, afrouxar para
# 85% via API transient (volta sozinho no restart).

# --- recursos do container ---------------------------------------------------
OS_MEMORY_LIMIT=13G
# 4 vCPU dedicadas; o setup.sh rebaixa se a máquina tiver menos.
OS_CPU_LIMIT=4

# --- heap --------------------------------------------------------------------
# 6 GiB ≈ 37% da RAM do host — dentro da regra dos 50% e ainda longe do teto de
# compressed oops. Em regime de consulta o uso fica em ~25%; a folga é para a
# carga mensal, que é onde o breaker `parent` (70% do heap) rejeitava os lotes
# do indexador — o alerta `BreakerDisparando` somou ~15 h numa semana de carga.
OS_JAVA_OPTS=-Xms6g -Xmx6g -XX:MaxDirectMemorySize=1g

# --- breakers ----------------------------------------------------------------
# fielddata 0%: mapping usa doc_values; qualquer uso de fielddata é erro de consulta.
OS_BREAKER_FIELDDATA_LIMIT=0%
# 70% em regime (mede heap real antes do GC).
OS_BREAKER_TOTAL_LIMIT=70%
OS_BREAKER_REQUEST_LIMIT=40%

# --- watermarks de disco -----------------------------------------------------
# flood_stage põe todos os índices em read-only. Duas gerações do índice
# convivem por 7 dias (N-1 = rollback).
OS_WATERMARK_LOW=75%
OS_WATERMARK_HIGH=85%
OS_WATERMARK_FLOOD=90%

# --- índice ------------------------------------------------------------------
# Settings de índice (`merge.*`, `refresh_interval`, `translog.*`) vivem no
# mapping versionado: ../index/busca_estabelecimento.json — não em opensearch.yml.
#
# `merge.scheduler.max_thread_count`: a fórmula do Lucene para disco sem seek é
# max(1, min(4, cores/2)) = 2 aqui. O valor 1 vem do perfil de host
# COMPARTILHADO, onde serializar o merge protege o vizinho; num host dedicado
# ele só faz os segmentos se acumularem.
OS_MERGE_THREADS=2
