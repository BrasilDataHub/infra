# Perfil dedicada-16gb — OpenSearch da BrasilDataHub
#
# Host de ~16 GiB / 4 vCPU dedicado ao motor de busca (Postgres noutra máquina).
# Limite do container: 10 GiB; heap 5 GiB (50%). Page cache livre ~4 GiB cobre
# o índice quente (~5,3 GB) com spill para NVMe local.
#
# Breaker `parent` a 70% em regime; na janela de carga inicial, afrouxar para
# 85% via API transient (volta sozinho no restart).

# --- recursos do container ---------------------------------------------------
OS_MEMORY_LIMIT=10G
# 4 vCPU dedicadas; o setup.sh rebaixa se a máquina tiver menos.
OS_CPU_LIMIT=4

# --- heap --------------------------------------------------------------------
# 5 GiB = 50% do limite. Os outros 5 GiB cobrem Netty direct, metaspace,
# thread stacks e folga contra OOM do cgroup.
OS_JAVA_OPTS=-Xms5g -Xmx5g -XX:MaxDirectMemorySize=1g

# --- breakers ----------------------------------------------------------------
# fielddata 0%: mapping usa doc_values; qualquer uso de fielddata é erro de consulta.
OS_BREAKER_FIELDDATA_LIMIT=0%
# 70% em regime (mede heap real antes do GC).
OS_BREAKER_TOTAL_LIMIT=70%
OS_BREAKER_REQUEST_LIMIT=40%

# --- watermarks de disco -----------------------------------------------------
# flood_stage põe todos os índices em read-only. Duas gerações do índice
# convivem por 7 dias (N-1 = rollback).
OS_WATERMARK_LOW=75%
OS_WATERMARK_HIGH=85%
OS_WATERMARK_FLOOD=90%

# --- índice ------------------------------------------------------------------
# Settings de índice (`merge.*`, `refresh_interval`, `translog.*`) vivem no
# mapping versionado: ../index/busca_estabelecimento.json — não em opensearch.yml.
