# Perfil dev-4gb — OpenSearch da BrasilDataHub
#
# NÃO é de produção. `--auto` nunca o escolhe; só com
# `--opensearch-profile dev-4gb` explícito.
#
# Host ~16 GiB / 4 vCPU com Postgres dedicada-8gb (ex.: bdh-local).
# Limite: 4 GiB; heap 2 GiB. Page cache disputa com PGDATA — latência fria
# não transfere para produção.
#
# Na carga: `OPENSEARCH_BULK_SIZE=1500` e `refresh_interval: -1`
# (devolver a 30s no fim). Com bulk 5000 o breaker dispara.

# --- recursos do container ---------------------------------------------------
OS_MEMORY_LIMIT=4G
# 2 de 4 vCPU, divididas com o Postgres.
OS_CPU_LIMIT=2

# --- heap --------------------------------------------------------------------
# 2 GiB = 50% do limite. On-heap em regime < 700 MiB; o que muda é a janela
# de carga (ver nota acima sobre OPENSEARCH_BULK_SIZE).
OS_JAVA_OPTS=-Xms2g -Xmx2g -XX:MaxDirectMemorySize=512m

# --- breakers ----------------------------------------------------------------
# Iguais à produção — erro de consulta visível em vez de OOM.
OS_BREAKER_FIELDDATA_LIMIT=0%
OS_BREAKER_TOTAL_LIMIT=70%
OS_BREAKER_REQUEST_LIMIT=40%

# --- watermarks de disco -----------------------------------------------------
# Iguais à produção. flood_stage exige PUT para liberar read-only.
OS_WATERMARK_LOW=75%
OS_WATERMARK_HIGH=85%
OS_WATERMARK_FLOOD=90%

# --- índice ------------------------------------------------------------------
# Settings de índice no mapping: ../index/busca_estabelecimento.json.
# `number_of_shards` permanece 6 (igual produção).
