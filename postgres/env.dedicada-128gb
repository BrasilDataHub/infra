# Perfil DEDICADA-128GB — máquina exclusiva do Postgres com 128 GB de RAM e
# 16–24 vCPUs, armazenamento NVMe local. Perfil máximo do catálogo: working
# set de bases grandes praticamente inteiro em RAM.
# Objetivo, cenários e justificativas: docs/perfis.md
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=32GB
PG_EFFECTIVE_CACHE_SIZE=96GB
PG_WORK_MEM=64MB
# 4GB: no PostgreSQL 17 o VACUUM passou a usar de fato mais de 1 GB
# (novo TID store) — em tabelas de dezenas de GB isso encurta a manutenção.
PG_MAINTENANCE_WORK_MEM=4GB
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_DEFAULT_STATISTICS_TARGET=200
PG_MAX_WORKER_PROCESSES=16
PG_MAX_PARALLEL_WORKERS=12
PG_MAX_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=4
PG_MAX_WAL_SIZE=16GB
PG_MIN_WAL_SIZE=2GB
PG_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.05
PG_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.02
