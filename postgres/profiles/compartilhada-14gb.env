# Perfil compartilhada-14gb — PostgreSQL da BrasilDataHub
#
# Host de 31 GiB / 12 vCPU compartilhado com OpenSearch (8 GiB) e sidecar de
# backup. Limite do container: 14 GiB; ~11,5 GiB de RSS; ~7,5 GiB de page cache
# para o mmap do Lucene.
#
# Ordem: `shared_buffers=8GB` só com Meilisearch parado (senão a soma estoura
# o host). `max_connections=60` + `work_mem=96MB` exige PgBouncer.

# --- recursos do container (não são parâmetros do Postgres) ----------------
PG_MEMORY_LIMIT=14G
# 4 GiB — build das MVs com hash paralelo precisa disso.
PG_SHM_BYTES=4294967296

# --- tuning do Postgres ---------------------------------------------------
# 60 com PgBouncer (transaction pooling). Sem isso, 100×96MB estoura o limite.
PG_MAX_CONNECTIONS=60
# memória
# 8 GiB + ~7,5 GiB de page cache ≈ 15,5 GiB efetivos (hot set 12–15 GB).
PG_SHARED_BUFFERS=8GB
PG_EFFECTIVE_CACHE_SIZE=15GB
# 96 MB — só com PgBouncer e max_connections=60.
PG_WORK_MEM=96MB
PG_HASH_MEM_MULTIPLIER=2.0
PG_MAINTENANCE_WORK_MEM=1536MB
PG_AUTOVACUUM_WORK_MEM=-1
# planner e IO
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAINTENANCE_IO_CONCURRENCY=200
PG_DEFAULT_STATISTICS_TARGET=100
# paralelismo — 12 vCPU divididas com o motor de busca.
# `per_gather=4` com /dev/shm de 4 GiB (validado pelo shm-guard).
PG_MAX_WORKER_PROCESSES=8
PG_MAX_PARALLEL_WORKERS=8
PG_MAX_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=2
PG_PARALLEL_SETUP_COST=1000
PG_PARALLEL_TUPLE_COST=0.1
# WAL e checkpoints
PG_MAX_WAL_SIZE=16GB
PG_MIN_WAL_SIZE=4GB
PG_WAL_BUFFERS=32MB
# arquivamento contínuo — par do alerta de 300s (backup/README.md)
PG_ARCHIVE_TIMEOUT=60s
# autovacuum
PG_AUTOVACUUM_MAX_WORKERS=4
PG_AUTOVACUUM_NAPTIME=30s
PG_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.1
PG_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.05
PG_AUTOVACUUM_VACUUM_INSERT_SCALE_FACTOR=0.1
PG_AUTOVACUUM_VACUUM_COST_LIMIT=2000
# diagnóstico
PG_STAT_STATEMENTS_MAX=5000
