# Perfil compartilhada-14gb — PostgreSQL da BrasilDataHub
#
# Máquina-alvo: host de 31 GiB e 12 vCPU COMPARTILHADO com o motor de busca
# (OpenSearch, 8 GiB) e o sidecar de backup. O Postgres fica com 14 GiB de
# limite de container e ~11,5 GiB de RSS esperado; os ~7,5 GiB restantes do
# host são page cache — e é ali que vive o `mmap` do Lucene.
#
# É o primeiro perfil "compartilhada" do catálogo, e o nome importa: o perfil em
# uso até 07/2026 chamava-se `dedicada-16gb` num host que NUNCA foi dedicado.
# O nome errado é o que faz alguém somar os limites e concluir que cabe.
#
# Justificativa número a número: docs/roadmap/20-arquitetura-de-busca-2026-07/
# 03-arquitetura-de-busca.md §3.1.
#
# ─────────────────────────────────────────────────────────────────────────────
# ORDEM DE APLICAÇÃO — não inverter
#
# `shared_buffers` de 8 GiB **só depois de o Meilisearch estar parado**
# (item 22 do roadmap). Aplicado antes, a soma passa dos 31 GiB do host:
# 14 (Postgres) + 12 (Meili) + 2 (métricas) já não cabe, e o OOM-killer escolhe
# pela pontuação, não pelo culpado.
#
# O par `max_connections` + `work_mem` (item 18) é o que pode entrar ANTES, e
# só junto com o PgBouncer — ver a nota abaixo.
# ─────────────────────────────────────────────────────────────────────────────

# --- recursos do container (não são parâmetros do Postgres) ----------------
PG_MEMORY_LIMIT=14G
# 4 GiB. O build das 19 MVs com hash paralelo já estourou 2 GiB e derrubou o
# ciclo — a correção de julho foi desligar o paralelismo; com 4 GiB ele volta.
PG_SHM_BYTES=4294967296

# --- tuning do Postgres ---------------------------------------------------
# 60, e não 100. É indivisível do PgBouncer (pgbouncer/): com transaction
# pooling, 60 conexões reais atendem centenas de clientes, e é o que torna
# work_mem de 96 MB seguro. A conta do pior caso:
#     100 conexões × 96 MB = 9,6 GB  → OOM dentro de um limite de 14 GiB
#      60 conexões × 96 MB = 5,8 GB  → cabe, com shared_buffers de 8 GiB
# Subir um sem o outro é a via rápida para o OOM-killer.
PG_MAX_CONNECTIONS=60
# memória
# 8 GiB. Com os ~7,5 GiB de page cache livres depois da saída do Meilisearch,
# dá 15,5 GiB efetivos contra um hot set de 12-15 GB. Cache hit projetado: ≥95%,
# contra os 77% medidos. Não subir para 10-12: roubaria do page cache, que é
# quem serve o mmap do motor de busca.
PG_SHARED_BUFFERS=8GB
# 15 GiB, e não os 12 de antes. Os 12 eram ficção: não existiam 7 GB de cache
# livre no host com o Meilisearch consumindo 93% do IO de leitura.
PG_EFFECTIVE_CACHE_SIZE=15GB
# 32 → 96 MB. Ataca 9.545 derrames de ~37 MB medidos — ~706 GB de IO evitável.
# NUNCA sem o PgBouncer e sem max_connections=60 (ver acima).
PG_WORK_MEM=96MB
PG_HASH_MEM_MULTIPLIER=2.0
PG_MAINTENANCE_WORK_MEM=1536MB
PG_AUTOVACUUM_WORK_MEM=-1
# planner e IO
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAINTENANCE_IO_CONCURRENCY=200
PG_DEFAULT_STATISTICS_TARGET=100
# paralelismo — 12 vCPU divididas com o motor de busca, daí a metade e não o
# total. `per_gather=4` com /dev/shm de 4 GiB é a combinação que o shm-guard
# valida no start.
PG_MAX_WORKER_PROCESSES=8
PG_MAX_PARALLEL_WORKERS=8
PG_MAX_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=2
PG_PARALLEL_SETUP_COST=1000
PG_PARALLEL_TUPLE_COST=0.1
# WAL e checkpoints
PG_MAX_WAL_SIZE=16GB
PG_MIN_WAL_SIZE=4GB
PG_WAL_BUFFERS=32MB
# arquivamento contínuo — o par indivisível do alerta de 300s (backup/README.md)
PG_ARCHIVE_TIMEOUT=60s
# autovacuum
PG_AUTOVACUUM_MAX_WORKERS=4
PG_AUTOVACUUM_NAPTIME=30s
PG_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.1
PG_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.05
PG_AUTOVACUUM_VACUUM_INSERT_SCALE_FACTOR=0.1
PG_AUTOVACUUM_VACUUM_COST_LIMIT=2000
# diagnóstico
PG_STAT_STATEMENTS_MAX=5000
