# Perfil COMPARTILHADA-8GB — o Postgres NÃO tem a máquina para si: divide
# 8 GB de RAM com aplicação, Redis, Meilisearch etc., ficando com um
# orçamento de ~4 GB. É o cenário atual do Base Empresarial e o perfil de
# sobrevivência para qualquer projeto começando num host único.
#
# São os DEFAULTS da imagem — implantar sem env nenhuma produz o mesmo
# resultado; este arquivo existe como fonte de verdade explícita.
# Objetivo, limitações e quando migrar: docs/perfis.md
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_RANDOM_PAGE_COST=1.5
PG_EFFECTIVE_IO_CONCURRENCY=100
PG_JIT=off
PG_MAX_WAL_SIZE=4GB
