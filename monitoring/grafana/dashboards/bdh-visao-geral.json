              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNonNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Busca — consultas/s e latência média",
      "datasource": {
        "type": "prometheus",
        "uid": "bdh-prometheus"
      },
      "description": "Média e não p95: o plugin expõe counters, não histograma. O p95 por classe de SLO vem do blackbox_exporter.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(opensearch_indices_search_query_count[5m])",
          "legendFormat": "consultas/s"
        },
        {
          "refId": "B",
          "expr": "rate(opensearch_indices_search_query_time_seconds[5m]) / clamp_min(rate(opensearch_indices_search_query_count[5m]), 0.001)",
          "legendFormat": "latência média (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "latência média (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "gauge",
      "title": "Heap do OpenSearch",
      "datasource": {
        "type": "prometheus",
        "uid": "bdh-prometheus"
      },
      "description": "Acima de 85% em regime é GC constante — a busca fica lenta antes de o motor cair.",
